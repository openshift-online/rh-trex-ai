package {{.Resource.NameLower}}

import (
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"os"

	"github.com/spf13/cobra"

	"{{.Module}}/pkg/config"
	"{{.Module}}/pkg/connection"
	"{{.Module}}/pkg/dump"
	"{{.Module}}/pkg/urls"
)

var args struct {
{{- range .Resource.UpdateFields}}
	{{.Name | camelCase}} {{.GoType}}
{{- end}}
	bodyFile string
}

var Cmd = &cobra.Command{
	Use:     "{{.Resource.NameLower}} ID [flags]",
	Aliases: []string{"{{.Resource.PluralLower}}"},
	Short:   "Update a {{.Resource.NameLower}} by ID",
	Long: "Update a {{.Resource.NameLower}} by ID using {{.Resource.UpdateMethod}}. Only the flags that are set are sent.\n\n" +
		"Examples:\n" +
		"  {{$.Binary}} update {{.Resource.NameLower}} ID{{range .Resource.UpdateFields}} --{{.FlagName}} <value>{{end}}\n" +
		"  {{$.Binary}} update {{.Resource.NameLower}} ID --body request.json",
	Args: cobra.ExactArgs(1),
	RunE: run,
}

func init() {
	fs := Cmd.Flags()
{{- range .Resource.UpdateFields}}
{{- if eq .GoType "string"}}
	fs.StringVar(&args.{{.Name | camelCase}}, "{{.FlagName}}", "", "{{.Name}} value.")
{{- else if eq .GoType "int"}}
	fs.IntVar(&args.{{.Name | camelCase}}, "{{.FlagName}}", 0, "{{.Name}} value.")
{{- else if eq .GoType "bool"}}
	fs.BoolVar(&args.{{.Name | camelCase}}, "{{.FlagName}}", false, "{{.Name}} value.")
{{- else if eq .GoType "float64"}}
	fs.Float64Var(&args.{{.Name | camelCase}}, "{{.FlagName}}", 0, "{{.Name}} value.")
{{- end}}
{{- end}}
	fs.StringVar(&args.bodyFile, "body", "", "File containing the request body as JSON.")
}

func run(cmd *cobra.Command, argv []string) error {
	id := argv[0]

	var body []byte
	var err error
	if args.bodyFile != "" {
		body, err = os.ReadFile(args.bodyFile)
		if err != nil {
			return fmt.Errorf("can't read body file: %w", err)
		}
	} else {
		request := map[string]interface{}{}
{{- range .Resource.UpdateFields}}
		if cmd.Flags().Changed("{{.FlagName}}") {
			request["{{.Name}}"] = args.{{.Name | camelCase}}
		}
{{- end}}
		if len(request) == 0 {
			return fmt.Errorf("nothing to update: set at least one field flag or pass --body")
		}
		body, err = json.Marshal(request)
		if err != nil {
			return fmt.Errorf("can't marshal request: %w", err)
		}
	}

	cfg, err := config.Load()
	if err != nil {
		return err
	}

	conn, err := connection.NewConnectionBuilder().Config(cfg).Build()
	if err != nil {
		return err
	}
	defer conn.Close()

{{if eq .Resource.UpdateMethod "PUT"}}
	resp, err := conn.Put(urls.{{.Resource.Name}}Path(id), bytes.NewReader(body))
{{- else}}
	resp, err := conn.Patch(urls.{{.Resource.Name}}Path(id), bytes.NewReader(body))
{{- end}}
	if err != nil {
		return fmt.Errorf("can't update {{.Resource.NameLower}}: %w", err)
	}
	defer resp.Body.Close()

	respBody, err := io.ReadAll(resp.Body)
	if err != nil {
		return fmt.Errorf("can't read response: %w", err)
	}

	switch resp.StatusCode {
	case 200, 202:
	case 204:
		fmt.Fprintf(os.Stdout, "{{.Resource.Name}} %s updated.\n", id)
		return nil
	default:
		return fmt.Errorf("API returned %d: %s", resp.StatusCode, string(respBody))
	}

	return dump.Pretty(os.Stdout, respBody)
}
