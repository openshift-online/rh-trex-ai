{
  "name": "{{.PluginName}}",
  "version": "0.0.1",
  "description": "OpenShift Console plugin for {{.DisplayName}}",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run webpack",
    "build-dev": "npm run clean && npm run webpack",
    "start": "npm run webpack -- serve --progress",
    "lint": "npm exec eslint -- src --fix",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.19.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.19.0",
    "@patternfly/react-core": "5.4.14",
    "@patternfly/react-icons": "5.4.2",
    "@patternfly/react-table": "5.4.16",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "@types/react-router-dom": "5.3.3",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.4",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "5.3.4",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.108.4",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6"
  },
  "consolePlugin": {
    "name": "{{.PluginName}}",
    "version": "0.0.1",
    "displayName": "{{.DisplayName}}",
    "description": "OpenShift Console plugin for managing {{.Project}} resources",
    "exposedModules": {
{{- range $i, $r := .Resources}}{{if $i}},{{end}}
      "{{$r.Name}}ListPage": "./components/{{$r.Name}}ListPage",
      "{{$r.Name}}DetailsPage": "./components/{{$r.Name}}DetailsPage",
      "{{$r.Name}}CreatePage": "./components/{{$r.Name}}CreatePage"
{{- end}}
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
