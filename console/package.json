{
  "name": "trex-console",
  "version": "0.0.1",
  "description": "OpenShift Console plugin for Rh Trex Ai Console",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve --progress",
    "lint": "yarn eslint src --fix",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.19.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.19.0",
    "@patternfly/react-core": "^5.4.0",
    "@patternfly/react-icons": "^5.4.0",
    "@patternfly/react-table": "^5.4.0",
    "@types/react": "^17.0.40",
    "@types/react-dom": "^17.0.13",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^7.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "consolePlugin": {
    "name": "trex-console",
    "version": "0.0.1",
    "displayName": "Rh Trex Ai Console",
    "description": "OpenShift Console plugin for managing rh-trex-ai resources",
    "exposedModules": {
      "BuildListPage": "./components/BuildListPage",
      "BuildDetailsPage": "./components/BuildDetailsPage",
      "BuildCreatePage": "./components/BuildCreatePage",
      "DinosaurListPage": "./components/DinosaurListPage",
      "DinosaurDetailsPage": "./components/DinosaurDetailsPage",
      "DinosaurCreatePage": "./components/DinosaurCreatePage",
      "EntityDefinitionListPage": "./components/EntityDefinitionListPage",
      "EntityDefinitionDetailsPage": "./components/EntityDefinitionDetailsPage",
      "EntityDefinitionCreatePage": "./components/EntityDefinitionCreatePage",
      "FieldDefinitionListPage": "./components/FieldDefinitionListPage",
      "FieldDefinitionDetailsPage": "./components/FieldDefinitionDetailsPage",
      "FieldDefinitionCreatePage": "./components/FieldDefinitionCreatePage",
      "FossilListPage": "./components/FossilListPage",
      "FossilDetailsPage": "./components/FossilDetailsPage",
      "FossilCreatePage": "./components/FossilCreatePage",
      "ProjectListPage": "./components/ProjectListPage",
      "ProjectDetailsPage": "./components/ProjectDetailsPage",
      "ProjectCreatePage": "./components/ProjectCreatePage",
      "RelationshipListPage": "./components/RelationshipListPage",
      "RelationshipDetailsPage": "./components/RelationshipDetailsPage",
      "RelationshipCreatePage": "./components/RelationshipCreatePage",
      "ScientistListPage": "./components/ScientistListPage",
      "ScientistDetailsPage": "./components/ScientistDetailsPage",
      "ScientistCreatePage": "./components/ScientistCreatePage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
